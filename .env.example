# Root env file for `docker compose up` — distinct from backend/.env.example,
# which is for running the backend directly on the host (outside Docker).
# Copy to .env and fill in secrets before running docker compose.

# ---- Ports (host side) ----
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ---- Postgres (db service) ----
POSTGRES_DB=gaming_platform
POSTGRES_USER=gaming_platform
POSTGRES_PASSWORD=change-me

# ---- Django ----
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
ENVIRONMENT=development

# Must match POSTGRES_* above — "db" is the compose service name, resolved
# on the compose network, not localhost.
DATABASE_URL_DEV=postgres://gaming_platform:change-me@db:5432/gaming_platform
DATABASE_URL_PROD=

# Frontend / CORS — the address the frontend container is reachable at
# (FRONTEND_PORT above), since nginx serves the SPA and proxies /api/ same-origin.
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Left False here for a local `docker compose up` over plain HTTP. Flip to
# True only once this sits behind real TLS termination.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ---- Cloudinary (media storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Rules assistant (RAG) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
EMBEDDING_MODEL=all-MiniLM-L6-v2
ANTHROPIC_API_KEY=

# ---- Cache — used for DRF throttling ----
# Leave unset for local `docker compose up` (falls back to per-process
# LocMemCache). Set in production: without it, rate limits are only correct
# on a single-process deployment — see backend/config/settings.py's CACHES
# comment for why. Add a `redis` service to docker-compose.yml if you want
# this exercised locally too.
REDIS_URL=

# ---- Google Sign-In ----
# Read by both the backend (GOOGLE_CLIENT_ID) and the frontend build
# (baked in as VITE_GOOGLE_CLIENT_ID via docker-compose.yml build args) —
# set it once here.
GOOGLE_CLIENT_ID=

# ---- Email (verification / password reset) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# ---- Frontend build-time API base ----
# Leave blank: nginx proxies /api/ same-origin, so the browser never needs a
# fixed host here. Only set this if the frontend is served from a different
# origin than the backend/nginx proxy.
VITE_API_URL=
