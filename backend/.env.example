# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production hardening (leave as-is in local dev)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rules assistant (RAG)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHROMA_DB_PATH=./chroma_db
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# JWT
JWT_SECRET_KEY=change-me

# Database — in production (ENVIRONMENT=production), settings.py enforces
# sslmode=require if the URL doesn't already specify one; add ?sslmode=...
# here yourself if your provider needs a different mode (e.g. verify-full).
DATABASE_URL_DEV=postgres://user:password@localhost:5432/gaming_platform
DATABASE_URL_PROD=

# Rules assistant (AI provider)
ANTHROPIC_API_KEY=

# Cache — used for DRF throttling. Leave unset in local dev (falls back to
# per-process LocMemCache). Set in production: without it, rate limits are
# only correct on a single-process deployment — see settings.py's CACHES
# comment for why.
REDIS_URL=

# Google Sign-In
GOOGLE_CLIENT_ID=

# Email (verification / password reset) — sent via Brevo's transactional
# email API (core/email_backend.py), not SMTP. Leave BREVO_API_KEY unset in
# local dev: emails print to the console instead of actually sending.
# Production requires it — see docs/SECURITY_CHECKLIST.md.
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com
